PORT=3001
DOCKLANE_CLUSTER_ID=default
# Required in secure mode: actual Swarm cluster ID, NOT the API alias above.
# Obtain and verify it out of band; do not discover it on every process start.
# In insecure development only, omit this variable to use first-identity discovery.
DOCKLANE_EXPECTED_CLUSTER_ID=
DOCKLANE_DATABASE_URL=mysql://docklane:change-me@127.0.0.1:3306/docklane
DOCKLANE_AGENT_URL=https://127.0.0.1:9443
DOCKLANE_AGENT_CA_FILE=/etc/docklane/pki/ca.pem
DOCKLANE_AGENT_CERT_FILE=/etc/docklane/pki/control-plane.pem
DOCKLANE_AGENT_KEY_FILE=/etc/docklane/pki/control-plane-key.pem

# JSON array. Keep real tokens outside source control.
# [{"token":"replace-with-at-least-16-chars","actorId":"local-admin","role":"ADMIN","clusters":["default"]}]
DOCKLANE_API_TOKENS=[]


# Native Docker Swarm join credentials are separate from Docklane bootstrap tokens.
# Keep these values outside source control in production.
# [{"clusterId":"default","remoteAddr":"10.0.0.10:2377","managerToken":"SWMTKN-1-manager-example-token","workerToken":"SWMTKN-1-worker-example-token"}]
DOCKLANE_SWARM_JOIN_JSON=[]
