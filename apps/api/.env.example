PORT=3001
DOCKLANE_CLUSTER_ID=default
DOCKLANE_AGENT_URL=https://127.0.0.1:9443
DOCKLANE_AGENT_CA_FILE=/etc/docklane/pki/ca.pem
DOCKLANE_AGENT_CERT_FILE=/etc/docklane/pki/control-plane.pem
DOCKLANE_AGENT_KEY_FILE=/etc/docklane/pki/control-plane-key.pem

# JSON array. Keep real tokens outside source control.
# [{"token":"replace-with-at-least-16-chars","actorId":"local-admin","role":"ADMIN","clusters":["default"]}]
DOCKLANE_API_TOKENS=[]
