[Unit]
Description=Docklane Swarm Agent
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/docklane-agent
EnvironmentFile=-/etc/docklane/agent.env
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/run/docker.sock
PrivateTmp=true

[Install]
WantedBy=multi-user.target
